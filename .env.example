# ---------------------------------------------------------------------------
# Copy to .env.local for local work. In Vercel, add the same keys under
# Project > Settings > Environment Variables.
# A PRODUCTION build is blocked until every required value is real (scripts/check-launch.mjs).
# ---------------------------------------------------------------------------

# --- Real company information (footer, Contact, legal pages, email footers) ---
NEXT_PUBLIC_SITE_URL=https://greenoaksrehab.com
COMPANY_NAME="Green Oaks Rehab"
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS_LINE1=
COMPANY_ADDRESS_LINE2=
COMPANY_CITY=
COMPANY_REGION=
COMPANY_POSTAL=
COMPANY_COUNTRY=
COMPANY_PHONE=
# Same number in international format for click-to-call, e.g. +15551234567
COMPANY_PHONE_E164=
# A mailbox you actually read: receives contact-form messages and order notifications
COMPANY_CONTACT_EMAIL=
COMPANY_HOURS=

# --- Shop ---
CURRENCY=USD
SHIPPING_FLAT_CENTS=695
FREE_SHIPPING_OVER_CENTS=7500

# --- Database (Postgres; Neon via the Vercel Marketplace). Then run: npm run db:migrate ---
DATABASE_URL=

# --- Security (generate: openssl rand -base64 48) ---
TOKEN_SECRET=
# Bearer token for POST /api/admin/broadcast (generate: openssl rand -base64 32)
ADMIN_TOKEN=

# --- PayPal (https://developer.paypal.com/dashboard/applications) ---
# Use sandbox while testing, live for real payments. Both IDs must be the same app.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- SparkPost ---
SPARKPOST_API_KEY=
# EU accounts: https://api.eu.sparkpost.com
SPARKPOST_API_URL=https://api.sparkpost.com
# Must be on the sending domain you verified in SparkPost
MAIL_FROM_EMAIL=hello@greenoaksrehab.com
MAIL_FROM_NAME="Green Oaks Rehab"
# Custom bounce domain (CNAME to SparkPost), e.g. bounce.greenoaksrehab.com
MAIL_RETURN_PATH=bounce@bounce.greenoaksrehab.com
# Basic-auth credentials YOU choose; enter the same values in the SparkPost webhook settings
SPARKPOST_WEBHOOK_USER=
SPARKPOST_WEBHOOK_PASS=

# --- Local development only (leave empty on Vercel) ---
# Point the Neon driver at a local Postgres HTTP proxy, and PayPal at a mock
NEON_LOCAL_HTTP_ENDPOINT=
PAYPAL_API_BASE=
